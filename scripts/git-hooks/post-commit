#!/bin/sh
# Book2Text post-commit：判断"这笔提交是否绕过了 pre-commit 闸"，绕过则留痕。
#
# 为什么留痕必须写在这里（实测 /tmp/hvtest）：
#   git commit --no-verify 会同时跳过 pre-commit 和 commit-msg，**但 post-commit 照跑**。
#   所以"允许绕过，但绕了留痕"只能挂在 post-commit 上；写进 commit-msg = 等于没写。
#
# 本 hook 永不阻塞提交（post-commit 发生在提交之后，退出码影响不了它），
# 它只做两件事：判定 + 追加一行日志。

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO" || exit 0

MARK="$REPO/.git/b2t-gate-pass"
BYPASS_LOG="$REPO/.git/b2t-gate-bypass.log"
HEAD_TREE=$(git rev-parse "HEAD^{tree}" 2>/dev/null) || exit 0

PASSED=""
if [ -f "$MARK" ]; then PASSED=$(cat "$MARK" 2>/dev/null || true); fi
rm -f "$MARK"

# tree 相同 = 这笔提交的索引正是 pre-commit 验过的那一份
if [ -n "$PASSED" ] && [ "$HEAD_TREE" = "$PASSED" ]; then
  exit 0
fi

SHA=$(git rev-parse --short HEAD 2>/dev/null) || exit 0
SUBJ=$(git log -1 --pretty=%s 2>/dev/null) || SUBJ="?"
BODY=$(git log -1 --pretty=%B 2>/dev/null) || BODY=""

# 绕过也要写理由；没写就标 NO-REASON（不是拦，是让它在日志里显眼）
if printf '%s' "$BODY" | grep -qi '^[[:space:]]*Bypass-Reason:'; then
  REASON=$(printf '%s' "$BODY" | grep -i '^[[:space:]]*Bypass-Reason:' | head -n 1 | sed 's/^[[:space:]]*//')
  TAG="WITH-REASON"
else
  REASON="Bypass-Reason: (缺)"
  TAG="NO-REASON"
fi

printf '%s\t%s\t%s\t%s\t%s\n' \
  "$(date '+%F %T')" "$SHA" "$TAG" "$REASON" "$SUBJ" >>"$BYPASS_LOG" 2>/dev/null || true

echo "" >&2
echo "⚠ post-commit：这笔提交没有经过 pre-commit 闸（$SHA $SUBJ）" >&2
if [ "$TAG" = "NO-REASON" ]; then
  echo "  而且提交信息里没有 Bypass-Reason: ——已标 NO-REASON。" >&2
  echo "  下次注意：--no-verify 时在提交信息里补一行 Bypass-Reason: <为什么>。" >&2
fi
echo "  已留痕：$BYPASS_LOG" >&2
echo "" >&2
exit 0
