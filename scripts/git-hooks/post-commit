#!/bin/sh
# Book2Text post-commit：区分「绕过」与「重写」，绕过才记账。
#
# 为什么必须区分（2026-10-29，Chief 抓）：
#   rebase / cherry-pick **会跑 post-commit**，而它们必然没有 pre-commit 写的
#   `.git/b2t-gate-pass` → 每笔都被记成"绕过"。实测一次 rebase 3 笔 → 账本翻倍，
#   status.sh 天天报"绕过 6 次、3 条 NO-REASON"，真实绕过是 0。
#   **闸自己产生假警报，比没有闸更快被关掉。**
#
# 两种判据都做（缺一不可）：
#   1) 重写进行中：`.git/rebase-merge` / `rebase-apply` / `CHERRY_PICK_HEAD` / `REVERT_HEAD` 存在；
#   2) 重写已完成：`post-rewrite` hook 把 new sha 记进 `.git/b2t-rewrites`，这里命中即 REWRITE
#      （rebase 收尾时才写 marker，两阶段都得覆盖）。
#
# 账本格式（制表符分隔）：
#   时间  sha  tag  branch@worktree  理由  subject
#   tag ∈ BYPASS / BYPASS-WITH-REASON / REWRITE

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO" || exit 0
GITDIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || git rev-parse --git-common-dir)
[ -n "$GITDIR" ] || GITDIR="$REPO/.git"

MARK="$GITDIR/b2t-gate-pass"
BYPASS_LOG="$GITDIR/b2t-gate-bypass.log"
REWRITES="$GITDIR/b2t-rewrites"

HEAD_SHA=$(git rev-parse HEAD 2>/dev/null) || exit 0
SHA=$(git rev-parse --short HEAD 2>/dev/null) || exit 0
HEAD_TREE=$(git rev-parse "HEAD^{tree}" 2>/dev/null) || exit 0
SUBJ=$(git log -1 --pretty=%s 2>/dev/null) || SUBJ="?"
BODY=$(git log -1 --pretty=%B 2>/dev/null) || BODY=""
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || BRANCH="?"
WHERE="$BRANCH@$(basename "$REPO")"

PASSED=""
if [ -f "$MARK" ]; then PASSED=$(cat "$MARK" 2>/dev/null || true); fi
rm -f "$MARK"

# ---- 是不是"重写"？----
IS_REWRITE=0
for m in rebase-merge rebase-apply; do
  [ -d "$GITDIR/$m" ] && IS_REWRITE=1
done
for m in CHERRY_PICK_HEAD REVERT_HEAD; do
  [ -f "$GITDIR/$m" ] && IS_REWRITE=1
done
if [ "$IS_REWRITE" = 0 ] && [ -f "$REWRITES" ] && grep -qx "$HEAD_SHA" "$REWRITES" 2>/dev/null; then
  IS_REWRITE=1
fi

if [ "$IS_REWRITE" = 1 ]; then
  printf '%s\t%s\tREWRITE\t%s\t%s\t%s\n' "$(date '+%F %T')" "$SHA" "$WHERE" "rebase/cherry-pick 重写，未经提交闸（不计入绕过）" "$SUBJ" >>"$BYPASS_LOG" 2>/dev/null || true
  exit 0
fi

# ---- 通过了闸就不记 ----
if [ -n "$PASSED" ] && [ "$HEAD_TREE" = "$PASSED" ]; then
  exit 0
fi

# ---- 真绕过 ----
if printf '%s' "$BODY" | grep -qi '^[[:space:]]*Bypass-Reason:'; then
  REASON=$(printf '%s' "$BODY" | grep -i '^[[:space:]]*Bypass-Reason:' | head -n 1 | sed 's/^[[:space:]]*//')
  TAG="BYPASS-WITH-REASON"
else
  REASON="Bypass-Reason: (缺)"
  TAG="BYPASS"
fi
printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "$SHA" "$TAG" "$WHERE" "$REASON" "$SUBJ" >>"$BYPASS_LOG" 2>/dev/null || true
echo "" >&2
echo "⚠ post-commit：这笔提交绕过了 pre-commit 闸（$SHA $SUBJ）" >&2
[ "$TAG" = "BYPASS" ] && echo "  没有 Bypass-Reason: ——已标 BYPASS。" >&2
echo "  已留痕：$BYPASS_LOG" >&2
exit 0
