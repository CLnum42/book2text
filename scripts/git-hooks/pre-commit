#!/bin/sh
# Book2Text pre-commit 闸（本机唯一自动回归：CI 已死，见 docs/refactor/reading-view-boundary.md §20.9 ⑬）
#
# 装法：sh scripts/install-hooks.sh   （幂等，且自带"真拒绝"自检）
# 卸法：git config --unset core.hooksPath
#
# ── 四条设计约束，每条都是实测逼出来的 ──────────────────────────────────────
# 1) **验索引，不验工作区**（2026-10-29 补，事故驱动）。
#    早期版本直接跑 `node tests/js/run.mjs`，读的是盘上文件；随后却用 `git write-tree`
#    宣称"这笔提交通过了闸"。四个 agent 共用一个工作区，盘上随时可能是别人未提交的半成品
#    ——实测 10:32 那次：绿的来源是 TestDev 未提交的 tests/js（mtime 10:32、+175/-29），
#    被提交的 62a532c 只含 docs/decisions.md，闸根本没看它。
#    现在：`git checkout-index -a --prefix=$TMP/` 把**索引**导出到临时目录再跑。
#    未 add 的文件天然不在里面，这正是想要的语义。
# 2) 缺依赖 fail closed：找不到 node 就拒绝提交。绝不 `|| exit 0`
#    ——那是"装了一个永远不会红的闸"，比不装更坏（D-110）。
# 3) hook 的 PATH 通常不含 ~/.local/bin（GUI / ssh / IDE 更明显），显式补查。
# 4) 闸里 `env -u B2T_APP_JS -u B2T_VIEW_JS -u B2T_STATIC_DIR`：
#    它们是"对历史版本复跑"的口子，hook 一旦继承到就等于"验了别的版本"。
#
# 通过时记录索引的 tree oid，供 post-commit 判断"这笔提交是不是绕过闸做的"。

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "✗ pre-commit：拿不到仓库根目录" >&2
  exit 1
}
cd "$REPO" || exit 1

# ---- 找 node：hook 的 PATH 不含 ~/.local/bin ----
NODE=""
for c in "$(command -v node 2>/dev/null)" "$HOME/.local/bin/node" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
  if [ -n "$c" ] && [ -x "$c" ]; then NODE="$c"; break; fi
done
if [ -z "$NODE" ]; then
  echo "✗ pre-commit：找不到 node" >&2
  echo "  查过：PATH / \$HOME/.local/bin / /opt/homebrew/bin / /usr/local/bin / /usr/bin" >&2
  echo "  拒绝提交——跑不起来的闸不允许静默放过（fail closed）。" >&2
  echo "  确实要先装 node，或临时用 git commit --no-verify（post-commit 会留痕）。" >&2
  exit 1
fi

# ---- 事后对账：已推提交里有没有没跑过 pytest 的 ----
# git push --no-verify 会跳过 pre-push，而 git 没有 post-push hook —— 所以"推送绕过"的留痕
# 只能靠这个必然会跑的回合（每次提交）。不是最理想，但它不依赖任何人记得。
STAMP="$REPO/.git/b2t-hooks-installed"
PLOG="$REPO/.git/b2t-pytest.log"
if git rev-parse --verify -q origin/main >/dev/null 2>&1 && [ -f "$STAMP" ]; then
  SINCE=$(cat "$STAMP" 2>/dev/null || echo 0)
  MISSING=0
  for sha in $(git log origin/main -n 20 --format='%H %ct' 2>/dev/null | awk -v s="$SINCE" '$2 >= s {print $1}'); do
    if [ ! -f "$PLOG" ] || ! awk -v s="$sha" -F'\t' '$1 == s { found = 1 } END { exit !found }' "$PLOG"; then
      MISSING=$((MISSING + 1))
    fi
  done
  if [ "$MISSING" -gt 0 ]; then
    echo "ℹ pre-commit：已推提交里有 $MISSING 笔没有 pytest 记录（git push --no-verify，或 .venv 缺失）" >&2
    echo "  pre-push 只在推送时跑 pytest（约 82s）；绕过它不会有人当场发现，只会在下一次提交时冒出来。" >&2
  fi
fi

TREE=$(git write-tree) || {
  echo "✗ pre-commit：git write-tree 失败（索引损坏？）" >&2
  exit 1
}

# ---- 把索引导出到临时目录：**要验的是索引，不是工作区** ----
TMP=$(mktemp -d "${TMPDIR:-/tmp}/b2t-precommit.XXXXXX") || {
  echo "✗ pre-commit：建不了临时目录" >&2
  exit 1
}
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT INT TERM

LOG="$REPO/.git/b2t-precommit.log"
if ! git checkout-index -a --prefix="$TMP/" 2>"$LOG"; then
  echo "✗ pre-commit：索引导出失败（日志 $LOG）" >&2
  exit 1
fi

# ---- 在导出目录里跑套件 ----
# GIT_DIR 指向原仓库：R11 / 特征契约要 `git show <tag>:<path>` 读历史版本，
# 临时目录没有 .git，不给它就会整条闸红。
START=$(date +%s)
( cd "$TMP" && GIT_DIR="$REPO/.git" \
    env -u B2T_APP_JS -u B2T_VIEW_JS -u B2T_STATIC_DIR \
    "$NODE" tests/js/run.mjs ) >"$LOG" 2>&1
RC=$?

if [ "$RC" -ne 0 ]; then
  echo "✗ pre-commit：索引里的 tests/js/run.mjs 红了（耗时 $(( $(date +%s) - START ))s）" >&2
  echo "  注意：验的是 **已 add 的内容**（索引导出），不是你盘上未 add 的改动。" >&2
  echo "  日志：$LOG" >&2
  tail -n 40 "$LOG" >&2
  echo "" >&2
  echo "  确需跳过：git commit --no-verify，并在提交信息里加一行" >&2
  echo "    Bypass-Reason: <为什么这次不能等>" >&2
  echo "  （绕过会被 post-commit 记进 .git/b2t-gate-bypass.log，没写理由的会被标 NO-REASON）" >&2
  exit 1
fi

# ---- 记录"这个 tree 通过了闸" ----
printf '%s' "$TREE" >"$REPO/.git/b2t-gate-pass" || {
  echo "✗ pre-commit：套件绿了，但写不了 .git/b2t-gate-pass（权限？）" >&2
  exit 1
}

echo "✓ pre-commit：索引版 tests/js/run.mjs 全绿（$(( $(date +%s) - START ))s，tree $(printf '%s' "$TREE" | cut -c1-8)）" >&2
exit 0
