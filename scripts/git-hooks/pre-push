#!/bin/sh
# Book2Text pre-push：**只查校验记录**（规则 #34，2026-11-05 三次真事故之后）。
#
# 为什么不再在这里跑重活：pre-push 里跑 node 35–50s + 全量测试 101–120s 的这两分钟，
# git 一直握着远端连接；GitHub 对端先把空闲连接掐掉 ⇒ 闸全绿却推不上去
# （`Connection to github.com closed by remote host`），最后只能 `git push --no-verify`
# ⇒ 闸从"强制执行"退化成"自觉执行"。
#
# 现在：重活在 `sh scripts/verify.sh [sha]` 里离线跑，跑完整绿才落一行记录（键 = sha，内容寻址）；
# 本钩子只做**查表**（< 1s），缺记录就拒绝并打印要跑的那条命令。
#
# 兼容：旧的 `RANGE<TAB><sha>` 记录仍然算数（它们是"那一轮真的跑过"的证据，别动）。
#
# fail closed：拿不到仓库 / 记录文件不可读 ⇒ 拒绝推送（不许"读不到就当通过"）。

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "✗ pre-push：拿不到仓库根目录，拒绝推送（fail closed）" >&2
  exit 1
}
cd "$REPO" || exit 1

COMMON=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
  echo "✗ pre-push：拿不到 git-common-dir，拒绝推送（fail closed）" >&2
  exit 1
}
# 记录文件按 glob 扫，不写死名字：新的离线校验写在 b2t-verify.log，
# 旧的 RANGE 记录留在历史文件名里（兼容证据，别动），两者都要算。
LIST="$COMMON/.b2t-verify-logs.$$"
find "$COMMON" -maxdepth 1 -name 'b2t-*.log' -type f >"$LIST" 2>/dev/null
if [ ! -s "$LIST" ]; then
  rm -f "$LIST"
  echo "✗ pre-push：读不到任何校验记录（$COMMON/b2t-*.log）——拒绝推送（fail closed）" >&2
  echo "  先跑：sh scripts/verify.sh <要推的 sha>" >&2
  exit 1
fi
trap 'rm -f "$LIST"' EXIT INT TERM

ZERO=0000000000000000000000000000000000000000
FAILED=0
CHECKED=0

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -n "${LOCAL_SHA:-}" ] || continue
  case "$LOCAL_SHA" in "$ZERO") continue ;; esac
  CHECKED=$((CHECKED + 1))
  SHORT=$(printf '%s' "$LOCAL_SHA" | cut -c1-8)

  FOUND=""
  while IFS= read -r FILE; do
    [ -r "$FILE" ] || continue
    # ① 新的离线校验记录：VERIFY <sha> <tree> <time> PASS …
    if awk -v sha="$LOCAL_SHA" '$1 == "VERIFY" && $2 == sha { found = 1 } END { exit found ? 0 : 1 }' "$FILE" 2>/dev/null; then
      FOUND="VERIFY"; break
    fi
    # ② 向后兼容：旧的 RANGE<TAB><sha>（那一轮 node + 全量测试都跑过）
    if awk -F'\t' -v sha="$LOCAL_SHA" '$1 == "RANGE" && $2 == sha { found = 1 } END { exit found ? 0 : 1 }' "$FILE" 2>/dev/null; then
      FOUND="RANGE"; break
    fi
  done <"$LIST"
  if [ -n "$FOUND" ]; then
    echo "✓ pre-push：$SHORT 有校验记录（$FOUND）" >&2
    continue
  fi

  echo "✗ pre-push：$SHORT 没有校验记录，拒绝推送" >&2
  echo "  先离线跑一次（约 3–4 分钟；不占远端连接）：" >&2
  echo "    sh scripts/verify.sh $LOCAL_SHA" >&2
  echo "  跑完整绿会写一行 VERIFY 记录，然后重推同一条命令即可。" >&2
  FAILED=1
done

if [ "$FAILED" -ne 0 ]; then
  exit 1
fi
[ "$CHECKED" -gt 0 ] || echo "… pre-push：没有要推的提交（空推送），跳过" >&2
exit 0
